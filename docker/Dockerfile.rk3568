# Docker for RK3568 (NPU)
FROM rockchip/rk3568-ubuntu:20.04

WORKDIR /app

RUN apt-get update && apt-get install -y python3-pip libopencv-dev
RUN pip3 install numpy torch ultralytics onnxruntime-rknn

COPY best_hybrid_transformer.onnx /app/model.onnx
COPY src/ /app/src/
COPY scripts/ /app/scripts/

CMD ["python3", "-m", "src.pipeline"]
