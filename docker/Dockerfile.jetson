# Docker for Jetson (TensorRT)
FROM nvcr.io/nvidia/l4t-tensorrt:r8.5.0.12-runtime

WORKDIR /app

# Install Python dependencies
RUN apt-get update && apt-get install -y python3-pip python3-opencv
RUN pip3 install numpy torch torchvision ultralytics onnxruntime

# Copy model and scripts
COPY best_hybrid_transformer.pth /app/model.pth
COPY src/ /app/src/
COPY scripts/ /app/scripts/

# Entry point
CMD ["python3", "-m", "src.pipeline"]
