"""Thư mục chứa dữ liệu đã xử lý."""

# Cấu trúc thư mục data/
# ├── raw/                    # Dữ liệu thô (URFD, GMDCSA, LE2I)
# │   ├── URFD/
# │   ├── GMDCSA24/
# │   └── LE2I/
# ├── processed/              # Dữ liệu đã trích đặc trưng
# │   ├── X_train.npy       # Features (N, 60, 60)
# │   ├── y_train.npy       # Labels (N, 1)
# │   └── groups.npy        # Group IDs cho subject-aware split
# └── AIO_Dataset/           # Dataset thống nhất
#     ├── fall/              # Video clip ngã
#     └── nofall/            # Video clip bình thường
