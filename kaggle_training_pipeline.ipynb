        with open(stats_path) as f:
            stats = json.load(f)
        print(f"\n[LE2I Stats]")
        print(f"  Total samples: {stats.get('total_samples', 'N/A')}")
        print(f"  Fall (Class 0): {stats.get('fall_samples', 'N/A')}")
