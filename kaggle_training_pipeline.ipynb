# %% [markdown]
# ## 9. Step 5: Merge Datasets (AIO + LE2I)

# %% [code]
# ============================================================
# STEP 5: Merge URFD+GMDCSA features với LE2I Zone-based features
# ============================================================
import numpy as np
import os

def load_processed_data(data_dir):
    """Load X, y, groups từ một thư mục."""
    x_path = os.path.join(data_dir, "X_train.npy")
    y_path = os.path.join(data_dir, "y_train.npy")
    g_path = os.path.join(data_dir, "groups.npy")
    
    if all(os.path.isfile(p) for p in [x_path, y_path]):
        X = np.load(x_path)
        y = np.load(y_path)
        g = np.load(g_path, allow_pickle=True) if os.path.isfile(g_path) else np.array(["unknown"] * len(y))
        return X, y, g
    return None, None, None

print("[INFO] Loading processed datasets...")

# Load AIO (URFD + GMDCSA)
X_aio, y_aio, g_aio = load_processed_data(PROCESSED)
print(f"[AIO] X={X_aio.shape if X_aio is not None else 'N/A'}, y={y_aio.shape if y_aio is not None else 'N/A'}")

# Load LE2I Zone-based
X_le2i, y_le2i, g_le2i = load_processed_data(LE2I_PROCESSED)
print(f"[LE2I] X={X_le2i.shape if X_le2i is not None else 'N/A'}, y={y_le2i.shape if y_le2i is not None else 'N/A'}")

# Merge
if X_aio is not None and X_le2i is not None:
    X_merged = np.concatenate([X_aio, X_le2i], axis=0)
    y_merged = np.concatenate([y_aio, y_le2i], axis=0)
    
    # Merge groups - thêm prefix để tránh trùng lặp
    g_aio_prefixed = np.array([f"aio_{str(x)}" for x in g_aio])
    g_le2i_prefixed = np.array([f"le2i_{str(x)}" for x in g_le2i])
    g_merged = np.concatenate([g_aio_prefixed, g_le2i_prefixed])
    
    print(f"\n[MERGED] X={X_merged.shape}, y={y_merged.shape}, groups={len(g_merged)}")
    
    # Save merged data
    MERGED_DIR = os.path.join(WORK_ROOT, "data", "merged")
    os.makedirs(MERGED_DIR, exist_ok=True)
    np.save(os.path.join(MERGED_DIR, "X_train.npy"), X_merged)
    np.save(os.path.join(MERGED_DIR, "y_train.npy"), y_merged)
    np.save(os.path.join(MERGED_DIR, "groups.npy"), g_merged, allow_pickle=True)
    print(f"[OK] Merged data saved to {MERGED_DIR}")
    
    DATA_DIR = MERGED_DIR
elif X_aio is not None:
    print("[INFO] Using AIO data only (LE2I not available)")
    DATA_DIR = PROCESSED
else:
    print("[ERROR] No data available!")
    DATA_DIR = None

