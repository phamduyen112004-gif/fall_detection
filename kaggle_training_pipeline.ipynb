if os.path.isdir(LE2I_ROOT):
    print(f"\n[INFO] Running Zone-based Protocol for LE2I...")
    
    # Tạo output directory
    os.makedirs(LE2I_PROCESSED, exist_ok=True)
    
    cmd_le2i_extract = [
        sys.executable, "le2i_zone_based_extractor.py",
