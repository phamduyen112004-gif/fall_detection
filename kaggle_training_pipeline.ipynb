# ## 7. Step 3: Trích Keypoints URFD + GMDCSA (data_extractor.py)

# %% [code]
# ============================================================
# STEP 3: Trích keypoints từ URFD + GMDCSA (60-D PIFR features)
# ============================================================

cmd_extract = [
    sys.executable, "data_extractor.py",
    "--aio-dir", AIO_ROOT,
    "--out-dir", PROCESSED,
    "--model", "yolo11n-pose.pt",
    "--device", "cpu",  # Kaggle P100: dùng CPU để tránh lỗi CUDA
]
run_step(cmd_extract, "Extract PIFR features (URFD + GMDCSA)")

# Kiểm tra output
x_path = os.path.join(PROCESSED, "X_train.npy")
y_path = os.path.join(PROCESSED, "y_train.npy")
g_path = os.path.join(PROCESSED, "groups.npy")

if all(os.path.isfile(p) for p in [x_path, y_path, g_path]):
    import numpy as np
    X = np.load(x_path)
    y = np.load(y_path).reshape(-1)
    g = np.load(g_path, allow_pickle=True)
    n_fall = int(np.sum(y >= 0.5))
    n_nofall = int(np.sum(y < 0.5))
    uniq_groups = len(set(str(x) for x in g.tolist()))
    print(f"[OK] Processed: N={len(y)} ({n_fall} fall, {n_nofall} nofall)")
    print(f"[OK] X shape: {X.shape}, y shape: {y.shape}")
    print(f"[OK] Groups: {len(g)} ({uniq_groups} unique)")
else:
    print("[WARN] Missing output files from data_extractor")

