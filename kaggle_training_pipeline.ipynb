import subprocess
import sys
import os

if DATA_DIR is not None:
    OUT_CKPT = os.path.join(WORK_ROOT, "best_hybrid_transformer.pth")
    
    cmd_train = [
        sys.executable, "train_transformer.py",
        "--data-dir", DATA_DIR,
        "--out", OUT_CKPT,
        "--device", "cuda" if os.path.exists("/dev/nvidia0") else "cpu",
        "--epochs", "100",
    ]
    
    run_step(cmd_train, "Train HybridFallTransformer")
    
    if os.path.isfile(OUT_CKPT):
        print(f"[OK] Model checkpoint: {OUT_CKPT}")
        import torch
        ckpt = torch.load(OUT_CKPT, map_location="cpu")
        print(f"[INFO] Best val F1: {ckpt.get('best_val_f1', 'N/A'):.4f}")
        print(f"[INFO] Optimal threshold: {ckpt.get('best_threshold', 'N/A'):.4f}")
else:
    print("[ERROR] DATA_DIR is None, cannot train")

