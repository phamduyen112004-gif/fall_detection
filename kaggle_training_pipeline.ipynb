        print(f"  Train samples: {stats.get('train_samples', 'N/A')}")
        print(f"  Val samples: {stats.get('val_samples', 'N/A')}")
        print(f"  Unique subjects: {stats.get('unique_subjects', 'N/A')}")
else:
