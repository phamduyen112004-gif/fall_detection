# ## 5. Step 1: Chuẩn bị AIO_Dataset (URFD + GMDCSA)

# %% [code]
# ============================================================
# STEP 1: Chuẩn bị AIO_Dataset từ URFD + GMDCSA-24
# ============================================================
import subprocess
import sys

def run_step(cmd, step_name):
    """Chạy một bước và in kết quả."""
    print(f"\n{'='*60}")
    print(f"STEP: {step_name}")
    print(f"{'='*60}")
    cmd_str = " ".join(str(c) for c in cmd)
    print(f"[CMD] {cmd_str}")
    result = subprocess.run(cmd, capture_output=False)
    if result.returncode != 0:
        print(f"[ERROR] Step failed with code {result.returncode}")
        return False
    print(f"[OK] {step_name} completed")
    return True

# Chuẩn bị URFD + GMDCSA
cmd_prepare = [
    sys.executable, "prepare_dataset.py",
    "--urfd-root", URFD_ROOT,
    "--gmdcsa-root", GMDCSA_ROOT,
    "--out", AIO_ROOT,
]
run_step(cmd_prepare, "Prepare AIO_Dataset (URFD + GMDCSA)")

# Kiểm tra output
if os.path.isdir(AIO_ROOT):
    fall_count = len(os.listdir(os.path.join(AIO_ROOT, "fall"))) if os.path.isdir(os.path.join(AIO_ROOT, "fall")) else 0
    nofall_count = len(os.listdir(os.path.join(AIO_ROOT, "nofall"))) if os.path.isdir(os.path.join(AIO_ROOT, "nofall")) else 0
    print(f"[OK] AIO_Dataset: {fall_count} fall + {nofall_count} nofall clips")

# %% [markdown]
# ## 6. Step 2: Chuẩn bị LE2I Dataset

# %% [code]
# ============================================================
# STEP 2: Chuẩn bị LE2I Dataset vào AIO_Dataset
# ============================================================

if os.path.isdir(LE2I_ROOT):
    print(f"\n[INFO] Processing LE2I dataset...")
    
    cmd_le2i_prepare = [
        sys.executable, "prepare_le2i_dataset.py",
        "--le2i-root", LE2I_ROOT,
        "--out", AIO_ROOT,
    ]
    
    # Thêm annotation CSV nếu có
    if os.path.isfile(LE2I_ANNOTATION_CSV):
        cmd_le2i_prepare.extend(["--annotation-csv", LE2I_ANNOTATION_CSV])
        print(f"[INFO] Using annotation CSV: {LE2I_ANNOTATION_CSV}")
    
    run_step(cmd_le2i_prepare, "Prepare LE2I Dataset")
    
    # Kiểm tra annotation JSON đã được tạo chưa
    le2i_annotation_json = os.path.join(AIO_ROOT, "_le2i_annotations.json")
    if os.path.isfile(le2i_annotation_json):
        print(f"[OK] LE2I annotation JSON: {le2i_annotation_json}")
        
        # Đếm số annotation
        import json
        with open(le2i_annotation_json) as f:
            ann = json.load(f)
        fall_ann = sum(1 for v in ann.values() if v.get("label") == 0)
        nofall_ann = sum(1 for v in ann.values() if v.get("label") == 1)
        with_fall_info = sum(1 for v in ann.values() if v.get("start_fall", -1) >= 0)
        print(f"[OK] LE2I annotations: {len(ann)} total ({fall_ann} fall, {nofall_ann} nofall)")
        print(f"[OK] With start_fall/end_fall: {with_fall_info}")
else:
    print("[WARN] LE2I_ROOT not found, skipping LE2I processing")
    le2i_annotation_json = None

