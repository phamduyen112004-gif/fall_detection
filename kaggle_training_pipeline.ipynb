import os
from pathlib import Path

def check_dataset_structure():
    """Kiểm tra cấu trúc dataset và in ra thông tin."""
    print("=" * 60)
    print("DATASET STRUCTURE CHECK")
    print("=" * 60)
    
    for name, root in [("URFD", URFD_ROOT), ("GMDCSA24", GMDCSA_ROOT), ("LE2I", LE2I_ROOT)]:
        if os.path.isdir(root):
            print(f"\n[{name}] ✅ Found at {root}")
            items = os.listdir(root)[:10]  # Chỉ show 10 item đầu
            print(f"  Items ({len(os.listdir(root))} total): {items}")
            
            # Đếm video files
            video_count = 0
            for ext in (".mp4", ".avi", ".zip"):
                for f in Path(root).rglob(f"*{ext}"):
                    video_count += 1
            print(f"  Video files: {video_count}")
        else:
            print(f"\n[{name}] ⚠️  Not found at {root}")
    
    if os.path.isfile(LE2I_ANNOTATION_CSV):
        print(f"\n[LE2I Annotation] ✅ Found: {LE2I_ANNOTATION_CSV}")
    else:
        print(f"\n[LE2I Annotation] ⚠️  Not found: {LE2I_ANNOTATION_CSV}")
        print("  (Sẽ dùng tên file để phân loại fall/adl)")

check_dataset_structure()

