        "--out-dir", LE2I_PROCESSED,
        "--val-subjects", "0.2",
        "--stride", "15",
        "--device", "cpu",
    ]
    
    # Thêm annotation JSON nếu có
    le2i_annotation_json = os.path.join(AIO_ROOT, "_le2i_annotations.json")
    if os.path.isfile(le2i_annotation_json):
        cmd_le2i_extract.extend(["--annotation-json", le2i_annotation_json])
    
    run_step(cmd_le2i_extract, "Zone-based LE2I Extraction")
    
    # Kiểm tra stats
